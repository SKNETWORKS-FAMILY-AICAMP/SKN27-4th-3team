# LLM provider 공통 설정 예시
# 실제 API key는 .env에만 넣고 저장소에 커밋하지 않는다.

LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_ID=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=400
LLM_TEMPERATURE=0.4

# Groq 예시
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Hugging Face 예시
# LLM_PROVIDER=huggingface

# Gemini 예시
# LLM_PROVIDER=gemini

# OpenRouter 예시
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Ollama local 예시
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
