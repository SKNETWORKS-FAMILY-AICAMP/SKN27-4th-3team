# LLM provider 공통 설정 예시
# 실제 API key는 .env에만 넣고 저장소에 커밋하지 않는다.

LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL_ID=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=400
LLM_TEMPERATURE=0.4

# Groq를 1차 provider로 사용한다.
# LLM_MODEL_ID는 실제 연결 직전에 Groq 공식 콘솔 또는 문서에서 사용 가능한 모델을 확인한 뒤 채운다.

# 대체 후보: Hugging Face
# LLM_PROVIDER=huggingface
# LLM_BASE_URL=

# 대체 후보: Gemini
# LLM_PROVIDER=gemini
# LLM_BASE_URL=

# 대체 후보: OpenRouter
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1

# 로컬 실험 후보: Ollama
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
