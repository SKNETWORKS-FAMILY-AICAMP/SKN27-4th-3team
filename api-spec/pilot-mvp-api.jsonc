  "endpoints": [
    {
      "id": "auth.register",
      "method": "POST",
      "path": "/auth/register",
      "summary": "Create a new user account.",
      "frontend_when_to_call": "회원가입 화면에서 사용자가 이메일/닉네임/비밀번호를 제출할 때 호출한다.",
      "backend_responsibility": [
        "Validate email format and uniqueness.",
        "Validate password policy.",
        "Create user and default profile.",
        "Optionally issue access token and refresh cookie."
      ],
      "request": {
        "body": {
          "email": "player@example.com",
          "nickname": "survivor01",
          "password": "plain-text-password-submitted-over-https"
        }
      },
      "response": {
        "data": {
          "user": {
            "$ref": "shared_models.User"
          },
          "access_token": "jwt_access_token_or_null",
          "expires_in": 900
        },
        "meta": {
          "request_id": "req_..."
        }
      },
      "errors": [
        "EMAIL_ALREADY_EXISTS",
        "NICKNAME_ALREADY_EXISTS",
        "PASSWORD_TOO_WEAK",
        "VALIDATION_ERROR"
      ],
      "notes": [
        "Review note: if this auth option is selected, frontend avoids localStorage/sessionStorage for access_token.",
        "If backend decides not to auto-login after register, access_token may be null."
      ]
    },

    {
      "id": "auth.login",
      "method": "POST",
      "path": "/auth/login",
      "summary": "Authenticate user and start a session.",
      "frontend_when_to_call": "로그인 화면에서 이메일/비밀번호를 제출할 때 호출한다.",
      "backend_responsibility": [
        "Verify credentials.",
        "Create refresh token family if needed.",
        "Set refresh token HttpOnly cookie.",
        "Return short-lived access token."
      ],
      "request": {
        "body": {
          "email": "player@example.com",
          "password": "plain-text-password-submitted-over-https"
        }
      },
      "response": {
        "data": {
          "user": {
            "$ref": "shared_models.User"
          },
          "access_token": "jwt_access_token",
          "expires_in": 900
        },
        "meta": {
          "request_id": "req_..."
        }
      },
      "errors": [
        "INVALID_CREDENTIALS",
        "ACCOUNT_LOCKED",
        "VALIDATION_ERROR"
      ],
      "notes": [
        "Review option: refresh token in HttpOnly cookie instead of response body.",
        "Frontend stores access token in memory only."
      ]
    },

    {
      "id": "auth.refresh",
      "method": "POST",
      "path": "/auth/refresh",
      "summary": "Rotate refresh token and issue a new access token.",
      "frontend_when_to_call": "Access token 만료 직전 또는 401 AUTH_TOKEN_EXPIRED 응답을 받은 뒤 호출한다.",
      "backend_responsibility": [
        "Read refresh token from HttpOnly cookie.",
        "Validate token hash and family.",
        "Detect reuse.",
        "Rotate refresh token.",
        "Return new access token."
      ],
      "request": {
        "headers": {
          "X-CSRF-Token": "csrf-token-if-required"
        },
        "body": {}
      },
      "response": {
        "data": {
          "access_token": "new_jwt_access_token",
          "expires_in": 900
        },
        "meta": {
          "request_id": "req_..."
        }
      },
      "errors": [
        "REFRESH_TOKEN_MISSING",
        "REFRESH_TOKEN_EXPIRED",
        "REFRESH_TOKEN_REUSED",
        "CSRF_FAILED"
      ],
      "notes": [
        "Review option: if REFRESH_TOKEN_REUSED occurs, frontend forces logout and shows a security warning.",
        "CSRF details are still decision_required."
      ]
    },

    {
      "id": "auth.logout",
      "method": "POST",
      "path": "/auth/logout",
      "summary": "End current session.",
      "frontend_when_to_call": "사용자가 로그아웃을 선택할 때 호출한다.",
      "backend_responsibility": [
        "Revoke current refresh token or token family depending on policy.",
        "Clear refresh cookie."
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer access-token-if-available",
          "X-CSRF-Token": "csrf-token-if-required"
        },
        "body": {
          "logout_all_devices": false
        }
      },
      "response": {
        "data": {
          "logged_out": true
        }
      },
      "errors": [
        "CSRF_FAILED"
      ],
      "notes": [
        "Review option: treat logout as successful on frontend even if access token is already expired, as long as cookie is cleared."
      ]
    },

    {
      "id": "profile.me",
      "method": "GET",
      "path": "/me",
      "summary": "Get current user and profile summary.",
      "frontend_when_to_call": "앱 부팅 후 로그인 상태 확인, 프로필 화면, 로비 상단 표시에서 호출한다.",
      "auth_required": true,
      "response": {
        "data": {
          "user": {
            "$ref": "shared_models.User"
          },
          "profile": {
            "$ref": "shared_models.PlayerProfile"
          }
        }
      },
      "errors": [
        "AUTH_REQUIRED",
        "AUTH_TOKEN_EXPIRED"
      ]
    },

    {
      "id": "story.cases.list",
      "method": "GET",
      "path": "/story/cases",
      "summary": "List available AI story cases.",
      "frontend_when_to_call": "로비 또는 AI 사건 선택 화면 진입 시 호출한다.",
      "auth_required": true,
      "backend_responsibility": [
        "Return available cases for MVP.",
        "Mark non-MVP cases unavailable if included as teasers."
      ],
      "response": {
        "data": {
          "cases": [
            {
              "$ref": "shared_models.StoryCaseSummary"
            }
          ]
        }
      },
      "notes": [
        "Review option: MVP returns 거울 속의 손님 as available.",
        "우물 밑의 목소리 and 문밖의 어머니 may be omitted or returned with mvp_available=false."
      ]
    },

    {
      "id": "story.cases.detail",
      "method": "GET",
      "path": "/story/cases/{case_id}",
      "summary": "Get case briefing and static story details.",
      "frontend_when_to_call": "사건 선택 후 브리핑 화면을 열 때 호출한다.",
      "auth_required": true,
      "path_params": {
        "case_id": "case_mirror_guest"
      },
      "response": {
        "data": {
          "case": {
            "$ref": "shared_models.StoryCaseDetail"
          }
        }
      },
      "errors": [
        "CASE_NOT_FOUND",
        "CASE_NOT_AVAILABLE"
      ],
      "notes": [
        "This endpoint returns content definitions and briefing text, not current match state.",
        "True/false clue definitions in this response are for content review and may not all be shown to players in final UX."
      ]
    },

    {
      "id": "matches.start_ai_story",
      "method": "POST",
      "path": "/matches/ai-story",
      "summary": "Start an AI story match.",
      "frontend_when_to_call": "브리핑 화면에서 사용자가 사건 시작 버튼을 누를 때 호출한다.",
      "auth_required": true,
      "backend_responsibility": [
        "Create Match, MatchParticipant, first Turn.",
        "Initialize player resources.",
        "Initialize apparition policy state.",
        "Return authoritative initial match state."
      ],
      "request": {
        "body": {
          "case_id": "case_mirror_guest",
          // Optional client id for duplicate-click protection.
          // If the same client_request_id is repeated by the same user,
          // candidate backend behavior: return the same created match or a clear idempotency error.
          "client_request_id": "uuid-generated-by-frontend"
        }
      },
      "response": {
        "data": {
          "match": {
            "$ref": "shared_models.MatchState"
          }
        }
      },
      "errors": [
        "CASE_NOT_FOUND",
        "CASE_NOT_AVAILABLE",
        "ACTIVE_MATCH_EXISTS",
        "IDEMPOTENCY_CONFLICT"
      ],
      "notes": [
        "MVP policy may allow only one active AI story match per user.",
        "Review option: if ACTIVE_MATCH_EXISTS occurs, frontend offers resume existing match."
      ]
    },

    {
      "id": "matches.current",
      "method": "GET",
      "path": "/matches/current",
      "summary": "Get current active match if one exists.",
      "frontend_when_to_call": "앱 부팅, 로비 진입, 새 사건 시작 전 기존 매치 확인에 사용한다.",
      "auth_required": true,
      "query": {
        "mode": "ai_story"
      },
      "response": {
        "data": {
          "has_active_match": true,
          "match": {
            "$ref": "shared_models.MatchState"
          }
        }
      },
      "errors": [
        "AUTH_REQUIRED"
      ],
      "notes": [
        "Review option: if has_active_match=false, match is null.",
        "This prevents users from accidentally starting duplicate MVP matches."
      ]
    },

    {
      "id": "matches.detail",
      "method": "GET",
      "path": "/matches/{match_id}",
      "summary": "Get authoritative match state.",
      "frontend_when_to_call": "결투 화면 진입, 새로고침, 턴 결과 후 상태 재동기화에 사용한다.",
      "auth_required": true,
      "path_params": {
        "match_id": "mat_..."
      },
      "response": {
        "data": {
          "match": {
            "$ref": "shared_models.MatchState"
          }
        }
      },
      "errors": [
        "MATCH_NOT_FOUND",
        "MATCH_ACCESS_DENIED"
      ],
      "notes": [
        "Review option: frontend treats this as stronger than locally cached state."
      ]
    },

    {
      "id": "turns.submit_action",
      "method": "POST",
      "path": "/matches/{match_id}/turns/{turn_id}/actions",
      "summary": "Submit player action for the current turn.",
      "frontend_when_to_call": "결투 화면에서 사용자가 행동 버튼을 누를 때 호출한다.",
      "auth_required": true,
      "path_params": {
        "match_id": "mat_...",
        "turn_id": "turn_..."
      },
      "request": {
        "body": {
          "action_code": "insight",
          // Optional at schema level, required for information actions.
          //
          // Owner decision D-401:
          // - Required for: insight, contract, seal.
          // - Optional for: curse, guard, trick, silence.
          //
          // Owner decision D-400:
          // Same-question repetition for Mirror Guest is tracked by repeated info_target_key,
          // not by free-text similarity or LLM judgment.
          "info_target_key": "mirror_back",
          // Client nonce is required for duplicate-submit protection.
          // candidate frontend behavior: generate a fresh UUID when the user attempts a turn submission.
          "client_nonce": "uuid-generated-by-frontend",
          // Optional UI telemetry. Backend can store it for behavior metrics,
          // review note: do not use this as security-critical timing unless the owner approves it.
          "client_submitted_at": "2026-06-01T09:01:07Z",
          "client_remaining_seconds": 18
        }
      },
      "backend_responsibility": [
        "Check match ownership.",
        "Check match and turn are active.",
        "Check turn_id is current.",
        "Check action is available.",
        "Check resource cost.",
        "Prevent duplicate client_nonce submission.",
        "Select AI apparition action using server policy.",
        "Resolve matchup through game_rules.",
        "Store ActionSubmission and TurnResult.",
        "Return authoritative TurnResult and next MatchState."
      ],
      "response": {
        "data": {
          "turn_result": {
            "$ref": "shared_models.TurnResult"
          }
        }
      },
      "errors": [
        "MATCH_NOT_FOUND",
        "MATCH_ACCESS_DENIED",
        "MATCH_ALREADY_RESOLVED",
        "TURN_NOT_CURRENT",
        "TURN_ALREADY_SUBMITTED",
        "ACTION_NOT_AVAILABLE",
        "INSUFFICIENT_RITUAL_POWER",
        "CLIENT_NONCE_REUSED",
        "TURN_DEADLINE_EXPIRED"
      ],
      "frontend_notes": [
        "Disable action buttons while the request is in flight.",
        "If TURN_ALREADY_SUBMITTED occurs, call GET /matches/{match_id} to resync.",
        "Do not locally apply resource deltas before the server response, except as a temporary loading animation.",
        "If TURN_DEADLINE_EXPIRED occurs, backend may resolve the turn as silence or timeout policy."
      ]
    },

    {
      "id": "turns.result",
      "method": "GET",
      "path": "/matches/{match_id}/turns/{turn_id}/result",
      "summary": "Get result for a resolved turn.",
      "frontend_when_to_call": "행동 제출 후 결과를 다시 가져오거나, 새로고침 후 특정 턴 로그를 확인할 때 호출한다.",
      "auth_required": true,
      "response": {
        "data": {
          "turn_result": {
            "$ref": "shared_models.TurnResult"
          }
        }
      },
      "errors": [
        "MATCH_NOT_FOUND",
        "TURN_NOT_FOUND",
        "TURN_NOT_RESOLVED",
        "MATCH_ACCESS_DENIED"
      ],
      "notes": [
        "POST submit_action response already includes turn_result, so this endpoint is mainly for resync/history."
      ]
    },

    {
      "id": "matches.result",
      "method": "GET",
      "path": "/matches/{match_id}/result",
      "summary": "Get final match result and summary.",
      "frontend_when_to_call": "매치가 resolved 상태가 된 후 결과 화면에서 호출한다.",
      "auth_required": true,
      "response": {
        "data": {
          "match_id": "mat_...",
          "result": "player_win",
          "result_reason": "seal_success",
          "case": {
            "case_id": "case_mirror_guest",
            "title": "거울 속의 손님"
          },
          "final_resources": {
            "sanity": 5,
            "ritual_power": 1,
            "curse_marks": 2,
            "true_name_fragments": 3,
            "false_clues": 1
          },
          "story_result_text": [
            "세 조각의 이름이 맞물리자 거울 안쪽의 방이 무너졌다.",
            "손님은 마지막으로 네 얼굴을 흉내 냈지만, 봉인지의 글자가 먼저 닫혔다.",
            "사건 파일은 봉인됨으로 기록된다."
          ],
          "turn_logs": [
            {
              "turn_number": 1,
              "text": "침묵은 답을 내놓지 않았다. 대신 다음 의식의 방향이 조금 좁혀졌다."
            }
          ],
          "style_summary": {
            "$ref": "shared_models.PlayerProfile.style_summary"
          },
          "llm_summary": {
            // MVP can keep this null and use story_result_text instead.
            // Review option: if later enabled, generate only after match resolution.
            "enabled": false,
            "text": null,
            "generation_id": null
          }
        }
      },
      "errors": [
        "MATCH_NOT_FOUND",
        "MATCH_NOT_RESOLVED",
        "MATCH_ACCESS_DENIED"
      ],
      "notes": [
        "Review boundary: LLM summary does not change final_resources, result, or turn_logs.",
        "Frontend can render story_result_text even when llm_summary.enabled=false."
      ]
    },

    {
      "id": "ai.style_profile",
      "method": "GET",
      "path": "/ai-profile/me",
      "summary": "Get current player's behavior style metrics.",
      "frontend_when_to_call": "프로필 화면 또는 결과 화면에서 스타일 지표를 별도 조회할 때 사용한다.",
      "auth_required": true,
      "response": {
        "data": {
          "style_summary": {
            "$ref": "shared_models.PlayerProfile.style_summary"
          },
          "calculation": {
            "sample_match_count": 3,
            "sample_turn_count": 28,
            "updated_at": "2026-06-01T09:30:00Z"
          }
        }
      },
      "errors": [
        "AUTH_REQUIRED"
      ],
      "decision_required": [
        "Calculate every turn, after every match, or by background job.",
        "Default values when denominator is zero.",
        "Whether frontend displays raw numbers, labels, or both."
      ]
    }
  ],

  "llm_and_rag_review": {
    "candidate_llm_uses": [
      "briefing variant generation",
      "apparition flavor dialogue",
      "post-match narrative summary",
      "player style prose summary",
      "operator/debug log summary"
