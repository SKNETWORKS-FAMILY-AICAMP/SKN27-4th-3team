{
  // pilot MVP API pre-decision review template.
  //
  // This file is JSONC, not strict JSON.
  // Reason: frontend/backend/story/AI workers need inline explanations.
  //
  // Usage:
  // - Treat this as a discussion draft, not an implementation contract.
  // - Examples here are candidate shapes for review.
  // - Nothing in this file is final until the owner approves it and it is moved to official implementation docs.
  // - Approved base contract now lives in:
  //   api-spec/pilot-mvp-api.official.jsonc
  //   api-spec/pilot-mvp-api.official.json
  // - Before implementing from this file, review owner decisions in:
  //   docs/08_Implementation_Contracts/03_오너_결정_워크시트.md
  //   docs/09_Approved_Contracts/17_백엔드_RAG_AI_Profile_구현_계약.md
  // - Fields marked decision_required are intentionally unresolved.
  //
  // Design direction under review:
  // - Frontend submits user intent.
  // - Backend validates, calculates, stores, and returns authoritative state.
  // - LLM/RAG may generate or retrieve flavor/context text, while rule authority remains an owner decision.
  "meta": {
    "name": "pilot-mvp-api",
    "version": "0.1.0-draft",
    "updated": "2026-06-02",
    "status": "pre_decision_review",
    "warning": "This JSONC is a commented proposal/template. It is not an approved API contract.",
    "official_base_contract": "api-spec/pilot-mvp-api.official.jsonc",
    "proposed_base_url": "/api/v1",
    "content_type": "application/json",
    "proposed_auth": "JWT access token + refresh token rotation",
    "source_docs": [
      "docs/08_Implementation_Contracts/01_세계관_프론트_공통_기준.md",
      "docs/08_Implementation_Contracts/02_API_Auth_DB_LLM_RAG_공통_계약.md",
      "docs/08_Implementation_Contracts/03_오너_결정_워크시트.md",
      "docs/01_MVP/04_MVP_확정_필요_항목.md",
      "docs/02_Game_Rules/04_상성_규칙.md",
      "docs/05_Story_Mode/02_거울_속의_손님.md"
    ]
  },

  "owner_decision_refs": {
    // These IDs are defined in docs/08_Implementation_Contracts/03_오너_결정_워크시트.md.
    // They explain which unresolved owner decisions affect this API proposal.
    "document_role": "D-001",
    "api_spec_format": "D-100",
    "response_envelope": "D-110",
    "auth_access_token_delivery": "D-120",
    "csrf_policy": "D-130",
    "backend_app_boundary": "D-200",
    "llm_phase": "D-300",
    "rag_phase": "D-310",
    "rag_retrieval_scope": "D-320",
    "mirror_guest_taboo_definition": "D-400",
    "info_target_required_policy": "D-401",
    "mirror_guest_info_targets": "D-402",
    "backend_rag_ai_profile_contract": "D-500"
  },

  "global_conventions": {
    // Candidate success response shape.
    // `data` is the actual payload.
    // `meta` is optional metadata useful for frontend debugging, pagination, request tracing, etc.
    "success_shape": {
      "data": {},
      "meta": {
        "request_id": "req_01H...",
        "server_time": "2026-06-01T09:00:00Z"
      }
    },

    // Candidate error response shape.
    // Review idea: frontend keys off `error.code`, not English/Korean message text.
    "error_shape": {
      "error": {
        "code": "ERROR_CODE",
        "message": "Human-readable fallback message.",
        "details": {}
      },
      "meta": {
        "request_id": "req_01H...",
        "server_time": "2026-06-01T09:00:00Z"
      }
    },

    // Candidate time format.
    "proposed_time_format": "ISO-8601 UTC",

    // ID format is not final.
    // Backend may use UUIDs or sortable IDs. Candidate frontend rule: treat all IDs as opaque strings.
    "id_policy": {
      "frontend_rule_candidate": "Treat every id as an opaque string. Do not parse meaning from it.",
      "decision_required": "Final ID format: UUIDv4, ULID, or database-generated string."
    },

    // Localized display text may be server-provided for story/log content.
    // UI chrome text such as button labels may live in frontend.
    "text_policy": {
      "server_provides": [
        "case title",
        "briefing text",
        "turn public log",
        "result story text",
        "clue text"
      ],
      "frontend_provides": [
        "button labels",
        "navigation labels",
        "generic empty states",
        "error message mapping by error.code"
      ]
    }
  },

  "auth_policy_options": {
    // Draft option, not a decision.
    // Refresh token is stored in an HttpOnly cookie.
    // Access token is returned in response body for early frontend development,
    // review note: avoid saving it in localStorage/sessionStorage if this option is selected.
    "access_token": {
      "proposed_delivery": "response_body",
      "proposed_storage_rule": "memory_only",
      "expires_in_seconds": 900,
      "decision_required": "Confirm whether access token remains body-delivered or moves to HttpOnly cookie only."
    },
    "refresh_token": {
      "proposed_delivery": "http_only_cookie",
      "expires_in_days": 14,
      "rotation": "rotate_on_every_refresh",
      "reuse_detection": "revoke_entire_token_family"
    },
    "csrf": {
      "applies_to": [
        "POST /auth/refresh",
        "POST /auth/logout"
      ],
      "header_name_draft": "X-CSRF-Token",
      "decision_required": "Confirm CSRF token issuing endpoint and exact header name."
    }
  },

  "domain_enums": {
    "match_mode": [
      "ai_story"
    ],
    "match_status": [
      "briefing",
      "active",
      "resolved",
      "abandoned"
    ],
    "turn_status": [
      "awaiting_player",
      "submitted",
      "resolved",
      "timed_out"
    ],
    "action_code": [
      "curse",
      "guard",
      "insight",
      "trick",
      "silence",
      "contract",
      "seal"
    ],
    "participant_kind": [
      "human",
      "ai_apparition"
    ],
    "mirror_guest_info_target_key": [
      // Owner decision D-402.
      // Frontend display labels may vary, but API keys should stay stable.
      "mirror_surface",
      "mirror_back",
      "missing_child_voice",
      "forgotten_room",
      "self_reflection"
    ],
    "match_result": [
      "player_win",
      "player_loss",
      "abandoned",
      "unresolved"
    ],
    "clue_truth_state": [
      // unknown: candidate UX keeps the truth value hidden.
      "unknown",
      // true_revealed: server has confirmed this as a true-name fragment.
      "true_revealed",
      // false_revealed: server has confirmed this as a false clue.
      "false_revealed"
    ]
  },

