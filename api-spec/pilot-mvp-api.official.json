  "api": {
    "prefix": "/api/v1",
    "response_envelope": {
      "success": "{ data, meta }",
      "error": "{ error, meta }",
      "meta_required_fields": [
        "request_id",
        "server_time"
      ],
      "request_id_policy": {
        "source": "server_generated",
        "format": "req_<uuid4_hex>",
        "external_header": "X-Request-ID ignored in 1st MVP",
        "response_header": "X-Request-ID"
      },
      "service_not_implemented_policy": {
        "status": 501,
        "error_code": "SERVICE_NOT_IMPLEMENTED",
        "details_required_fields": [
          "service"
        ],
        "mock_success_forbidden": true
      },
      "error_required_fields": [
        "code",
        "message",
        "details"
      ]
    },
    "auth": {
      "access_token_delivery": "HttpOnly cookie",
      "refresh_token_delivery": "HttpOnly cookie",
      "access_token_type": "JWT",
      "access_token_ttl_minutes": 15,
      "jwt_algorithm": "HS256",
      "jwt_signing_secret": "Django settings.SECRET_KEY from DJANGO_SECRET_KEY",
      "access_token_claims": [
        "token_type",
        "sub",
        "iat",
        "exp"
      ],
      "refresh_token_type": "JWT",
      "refresh_token_ttl_days": 14,
      "refresh_token_claims": [
        "token_type",
        "sub",
        "jti",
        "family_id",
        "iat",
        "exp"
      ],
      "refresh_token_family_id": "UUIDv4 generated on successful login",
      "refresh_token_jti": "UUIDv4 generated for each refresh token",
      "refresh_token_storage": "HMAC-SHA256 hash only; raw token storage forbidden",
      "refresh_token_rotation": "old token becomes rotated; new refresh token is issued",
      "refresh_token_reuse_detection": {
        "reused_statuses": [
          "rotated",
          "revoked",
          "reused"
        ],
        "on_reuse": [
          "revoke entire family_id",
          "clear access and refresh cookies",
          "write security event log",
          "return REFRESH_TOKEN_REUSED"
        ],
        "grace_window": "none",
        "concurrency": "DB transaction with row lock"
      },
      "security_event_storage": {
        "fields": [
          "event_type",
          "user_id",
          "request_id",
          "metadata",
          "created_at"
        ],
        "user_id": "nullable; unauthenticated or unknown actor is null",
        "request_id": "nullable server-generated request id",
        "metadata": "JSON object with default {}; raw token, token hash, password, cookie, and CSRF token values forbidden",
        "actor_foreign_key": "forbidden until user deletion/event retention lifecycle is approved"
      },
      "token_storage_forbidden": [
        "localStorage",
        "sessionStorage",
        "Authorization Bearer header from frontend"
      ],
      "same_site": "Lax",
      "cookie_paths": {
        "access": "/api/v1",
        "refresh": "/api/v1/auth"
      },
      "secure_cookie": {
        "local_dev": false,
        "production": true
      },
      "password_policy": {
        "min_length": 10,
        "max_length": 128,
        "common_password_blocked": true,
        "numeric_only_blocked": true,
        "similar_to_email_or_nickname_blocked": true,
        "validation_error_code": "VALIDATION_ERROR"
      },
      "login_failure_rate_limit": {
        "identity": "normalized email + server observed REMOTE_ADDR",
        "trusted_proxy_headers": "not used until a trusted proxy policy is approved",
        "window_seconds": 600,
        "failure_limit": 5,
        "lockout_seconds": 900,
        "http_status": 429,
        "error_code": "LOGIN_RATE_LIMITED",
        "reset_on_success": true,
        "invalid_credentials_response_hides_account_existence": true
      }
    },
    "csrf": {
      "applies_to_methods": [
        "POST",
        "PATCH",
        "PUT",
        "DELETE"
      ],
      "endpoint": "GET /api/v1/auth/csrf",
      "header": "X-CSRFToken",
      "rotation": {
        "login": "rotate",
        "refresh": "keep",
        "after_logout": "new GET /api/v1/auth/csrf required"
      },
      "storage": "frontend memory only",
      "trusted_origins": "explicit allowlist only",
      "cors_origins": "explicit allowlist only"
    },
    "idempotency": {
      "match_start": "client_request_id",
      "turn_submit": "client_nonce"
    },
    "timeout_policy": {
      "scope": "1st MVP AI story",
      "basis": "server deadline_at",
      "browser_close": "not an immediate timeout",
      "network_disconnect": "not an immediate timeout",
      "no_valid_submission_until_deadline": "resolve as timeout",
      "timeout_default_player_action": "silence",
      "reconnect": "GET /api/v1/matches/{match_id}"
    }
  },
